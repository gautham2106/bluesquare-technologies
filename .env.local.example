# --- FlatHunter (/flathunter) -----------------------------------------
# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Meta Pixel
NEXT_PUBLIC_META_PIXEL_ID=
# Conversions API access token — Events Manager → Settings → Conversions API → Generate Access Token.
# Optional: enables server-side Lead/Purchase events as a backup to the browser pixel.
META_CONVERSIONS_API_TOKEN=
# Paste the code from Events Manager → Test Events while verifying, then remove it —
# leaving it set hides real events from your normal reporting.
META_TEST_EVENT_CODE=
